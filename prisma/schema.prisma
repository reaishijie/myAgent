generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum UserPlan {
  FREE
  PRO
  MAX
}

enum UserStatus {
  NORMAL
  DISABLED
  DELETED
}

model User {
  id          Int        @id @default(autoincrement())
  avatar      String?    @db.VarChar(255)
  username    String     @unique @db.VarChar(30)
  nickname    String?    @db.VarChar(30)
  password    String     @db.VarChar(255)
  email       String?    @unique @db.VarChar(255)
  phone       String?    @unique @db.VarChar(15)
  status      UserStatus @default(NORMAL)
  plan        UserPlan   @default(FREE)
  balance     Decimal?   @default(0) @db.Decimal(12, 2)
  planEndTime DateTime?  @map("plan_end_time") @db.Timestamp(6)
  role        UserRole   @default(USER)
  createdAt   DateTime?  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime?  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  profile     Json?

  @@index([status], map: "user_status_idx")
  @@index([createdAt], map: "user_created_idx")
  @@index([plan, planEndTime], map: "user_plan_time_idx")
  @@map("users")
}

model KnowledgeDocument {
  id        Int              @id @default(autoincrement())
  title     String           @db.VarChar(120)
  content   String
  contentHash String?        @unique @map("content_hash") @db.VarChar(64)
  metadata  Json?
  createdAt DateTime?        @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime?        @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  chunks    KnowledgeChunk[]

  @@index([createdAt], map: "knowledge_document_created_idx")
  @@map("knowledge_documents")
}

model KnowledgeChunk {
  id             Int               @id @default(autoincrement())
  documentId     Int               @map("document_id")
  chunkIndex     Int               @map("chunk_index")
  content        String
  embedding      Unsupported("vector")
  embeddingModel String            @map("embedding_model") @db.VarChar(120)
  tokenCount     Int?              @map("token_count")
  createdAt      DateTime?         @default(now()) @map("created_at") @db.Timestamp(6)
  document       KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex], map: "knowledge_chunk_document_index_unique")
  @@index([documentId], map: "knowledge_chunk_document_idx")
  @@map("knowledge_chunks")
}
